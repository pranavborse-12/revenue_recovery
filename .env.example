# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file -- it is already listed in .gitignore.

# --- Application ---
APP_ENV=development

# --- Razorpay Test Mode credentials ---
# Get these from: Razorpay Dashboard -> Test Mode -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Get this from: Razorpay Dashboard -> Test Mode -> Settings -> Webhooks
# (set when you create the webhook -- you choose this secret value)
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Database ---
# Local PostgreSQL example:
DATABASE_URL=postgresql+psycopg://revenue_recovery:revenue_recovery@localhost:5432/revenue_recovery

# --- Logging ---
LOG_LEVEL=INFO

# --- Redis / Celery (Phase 2) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Retry policy (Phase 2) ---
# Minutes to wait before each retry attempt. List length = max attempts.
RETRY_DELAY_MINUTES=[30,360,1440]

# --- Logging ---
LOG_LEVEL=INFO
